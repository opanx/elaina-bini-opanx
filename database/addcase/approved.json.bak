    "code": "case 'cekbumi':\n  try {\n    await bulter.sendMessage(m.chat, { react: { text: '⏳', key: m.key } });\n\n    const now = new Date();\n    const utcHours = now.getUTCHours();\n    const utcMinutes = now.getUTCMinutes();\n    const utcSeconds = now.getUTCSeconds();\n\n    const totalSecondsInDay = utcHours * 3600 + utcMinutes * 60 + utcSeconds;\n    const solarDaySeconds = 86400;\n    const siderealDaySeconds = 86164.0916;\n\n    const solarRotationAngle = ((totalSecondsInDay / solarDaySeconds) * 360).toFixed(2);\n    const siderealRotationAngle = ((totalSecondsInDay / siderealDaySeconds) * 360).toFixed(2);\n\n    const message = `*🌍 INFORMASI ROTASI BUMI*\n\n*Waktu UTC:* ${utcHours.toString().padStart(2, '0')}:${utcMinutes.toString().padStart(2, '0')}:${utcSeconds.toString().padStart(2, '0')}\n*Sudut Rotasi (Solar):* ${solarRotationAngle}°\n*Sudut Rotasi (Sidereal):* ${siderealRotationAngle}°\n\n*📊 Data Akurat:*\n• Kecepatan rotasi di ekuator: _1.670 km/jam_\n• Periode rotasi (sideris): _23j 56m 4.1d_\n• Periode rotasi (solar): _24 jam tepat_\n• Kecepatan sudut: _15°/jam_\n\n*📈 Interpretasi:*\nBumi telah berotasi ${solarRotationAngle}° dari posisi tengah malam UTC (00:00). Sudut ini dihitung secara real-time berdasarkan waktu atomik internasional.\n\n_Data dihitung menggunakan formula astronomi standar dengan presisi milidetik._`;\n\n    await reply(message);\n  } catch (error) {\n    await reply(`*Error:* Gagal menghitung rotasi bumi\\n_${error.message}_`);\n  }\n  break;\ncase 'rotasibumi':\ncase 'earthrotation':\n  try {\n    await bulter.sendMessage(m.chat, { react: { text: '⏳', key: m.key } });\n\n    const now = new Date();\n    const utcTotalSeconds = now.getUTCHours() * 3600 + now.getUTCMinutes() * 60 + now.getUTCSeconds();\n    const rotationPercent = ((utcTotalSeconds / 86164.0916) * 100).toFixed(3);\n\n    const message = `*🔄 Rotasi Bumi Saat Ini:*\n• Persentase rotasi: _${rotationPercent}%_\n• Sudut rotasi: _${((utcTotalSeconds / 86164.0916) * 360).toFixed(2)}°_\n• Kecepatan linear: _1.670 km/jam_\n\n_Bumi berotasi penuh setiap 23 jam 56 menit 4.1 detik (periode sideris)_`;\n\n    await reply(message);\n  } catch (error) {\n    await reply(`*Error:* ${error.message}`);\n  }\n  break;",
